# Copy this file to .env and fill in unique values before starting Docker Compose.
# Keep POSTGRES_PASSWORD URL-safe (letters and numbers only).
POSTGRES_PASSWORD=

# Use a random secret with at least 32 characters.
JWT_SECRET=

# These passwords are only used when the seed creates missing accounts.
# Use a unique password of at least 12 characters for each account.
OWNER_EMAIL=owner@toko.local
OWNER_PASSWORD=
STAFF_EMAIL=staff@toko.local
STAFF_PASSWORD=
