// use prisma-8

model User {
  id           Int                @id @default(autoincrement())
  email        String             @unique
  name         String
  passwordHash String
  role         String             @default("STAFF")
  movements    StockMovement[]
  sales        Sale[]
  createdAt    DateTime           @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt
}

model Category {
  id        Int                @id @default(autoincrement())
  name      String             @unique
  products  Product[]
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model Rack {
  id          Int                @id @default(autoincrement())
  code        String             @unique
  description String?
  products    Product[]
  createdAt   DateTime           @default(now()) @onCreate(now())
  updatedAt   temporal.UpdatedAt
}

model Product {
  id         Int                @id @default(autoincrement())
  name       String
  sku        String             @unique
  price      Int
  minStock   Int                @default(0)
  category   Category           @relation(fields: [categoryId], references: [id])
  categoryId Int
  rack       Rack?              @relation(fields: [rackId], references: [id])
  rackId     Int?
  movements  StockMovement[]
  saleItems  SaleItem[]
  createdAt  DateTime           @default(now()) @onCreate(now())
  updatedAt  temporal.UpdatedAt
}

model StockMovement {
  id        Int       @id @default(autoincrement())
  type      String
  quantity  Int
  note      String?
  product   Product   @relation(fields: [productId], references: [id])
  productId Int
  user      User      @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime  @default(now()) @onCreate(now())
}

model Sale {
  id        Int        @id @default(autoincrement())
  total     Int
  paid      Int
  change    Int
  user      User       @relation(fields: [userId], references: [id])
  userId    Int
  items     SaleItem[]
  createdAt DateTime   @default(now()) @onCreate(now())
}

model SaleItem {
  id        Int      @id @default(autoincrement())
  quantity  Int
  price     Int
  sale      Sale     @relation(fields: [saleId], references: [id])
  saleId    Int
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
}